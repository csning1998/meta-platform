[Unit]
Description=Harbor Bootstrapper Service
After=docker.service vault-agent.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ shared_harbor_bootstrapper_harbor_install_dir }}
ExecStart={{ docker_executable | default('/usr/bin/docker') }} compose up -d
ExecStop={{ docker_executable | default('/usr/bin/docker') }} compose down --remove-orphans

[Install]
WantedBy=multi-user.target
