agent {
  data_dir     = "{{ spire_agent_dir_data }}"
  log_level    = "{{ utils_spire_agent_log_level }}"
  server_address = "{{ spire_parent_node_ip }}"
  server_port    = "{{ spire_server_port }}"
  socket_path    = "{{ utils_spire_agent_socket_dir }}/api.sock"
  trust_domain   = "{{ spire_trust_domain }}"
  trust_bundle_path = "{{ utils_spire_agent_dir_config }}/bundle.pem"
{% if not utils_spire_agent_already_attested %}
  # Present only until the first successful attestation persists an identity into
  # data_dir. A rerun of this role removes this line once data_dir holds an identity.
  join_token = "{{ utils_spire_agent_join_token }}"
{% endif %}
}

plugins {
  NodeAttestor "join_token" {
    plugin_data {}
  }

  WorkloadAttestor "docker" {
    plugin_data {}
  }

  KeyManager "disk" {
    plugin_data {
      directory = "{{ spire_agent_dir_data }}"
    }
  }
}
