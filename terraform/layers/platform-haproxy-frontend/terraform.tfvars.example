
target_components = { "frontend" = { service = "haproxy", component = "frontend" } }

primary_role = "frontend"

service_config = {
  frontend = {
    role            = "haproxy"
    base_image_path = "../../../packer/output/base-baremetal-haproxy/ubuntu-24-base-baremetal-haproxy.qcow2"
    nodes = {
      "00" = { ip_suffix = 200, vcpu = 2, ram_size = 512 }
    }
  }
}

# The frontend segment of platform-observability, cidr_index 155 of the platform network.
observability_config = {
  scraper_cidrs = ["172.16.155.0/24"]
}
