# One entry per tenant workload, keyed by the name below the owner code.
# owner defaults to the project code of the foundation layer, and kv_paths, kv_read_paths, and pki_roles are relative to the owner.
# workload names a catalog service and component, and kubernetes names a namespace and a service account.
# issuer = "child": a workload attested by the SPIRE Child, such as a pod or a VM agent of the Child. provision-spire-child creates the role.
# issuer = "parent": a workload attested by the SPIRE Parent. This layer creates the role.
tenants = {
  "e2e-probe" = {
    issuer     = "child"
    kubernetes = { namespace = "e2e-probe", service_account = "e2e-probe" }
    kv_paths   = ["e2e-probe"]
  }

  "keycloak-frontend" = {
    issuer        = "child"
    workload      = { service = "keycloak", component = "frontend" }
    kv_read_paths = ["keycloak/frontend"]
    pki_roles     = ["keycloak-frontend"]
  }

  "harbor-origin-frontend" = {
    issuer        = "child"
    workload      = { service = "harbor-origin", component = "frontend" }
    kv_read_paths = ["harbor-origin/frontend"]
  }
}
