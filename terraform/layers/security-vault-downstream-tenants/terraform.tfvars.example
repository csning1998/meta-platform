# One entry per tenant workload.
# issuer = "child": a workload attested by the SPIRE Child, such as a pod or a VM agent of the Child. provision-spire-child creates the role.
# issuer = "parent": a workload attested by the SPIRE Parent. This layer creates the role.
tenants = {
  "meta-platform-e2e-probe" = {
    issuer    = "child"
    spiffe_id = "spiffe://production.homelab-infra.dev/ns/e2e-probe/sa/e2e-probe"
    kv_paths  = ["meta-platform/e2e-probe"]
  }

  "meta-platform-keycloak-frontend" = {
    issuer        = "child"
    spiffe_id     = "spiffe://production.homelab-infra.dev/meta-platform/keycloak/frontend"
    kv_read_paths = ["meta-platform/keycloak/frontend"]
    pki_roles     = ["meta-platform-keycloak-frontend"]
  }

  "meta-platform-harbor-origin-frontend" = {
    issuer        = "child"
    spiffe_id     = "spiffe://production.homelab-infra.dev/meta-platform/harbor-origin/frontend"
    kv_read_paths = ["meta-platform/harbor-origin/frontend"]
  }
}
