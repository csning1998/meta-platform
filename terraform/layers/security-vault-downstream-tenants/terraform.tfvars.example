# One entry per tenant workload.
# issuer = "child": a workload attested by the SPIRE Child, such as a pod or a VM agent of the Child. provision-spire-child creates the role.
# issuer = "parent": a workload attested by the SPIRE Parent. This layer creates the role.
tenants = {
  "platform-foundation-e2e-probe" = {
    issuer    = "child"
    spiffe_id = "spiffe://production.homelab-infra.dev/ns/e2e-probe/sa/e2e-probe"
    kv_paths  = ["platform-foundation/e2e-probe"]
  }

  "platform-foundation-keycloak-frontend" = {
    issuer        = "child"
    spiffe_id     = "spiffe://production.homelab-infra.dev/platform-foundation/keycloak/frontend"
    kv_read_paths = ["platform-foundation/keycloak/frontend"]
    pki_roles     = ["platform-foundation-keycloak-frontend"]
  }

  "platform-foundation-harbor-origin-frontend" = {
    issuer        = "child"
    spiffe_id     = "spiffe://production.homelab-infra.dev/platform-foundation/harbor-origin/frontend"
    kv_read_paths = ["platform-foundation/harbor-origin/frontend"]
  }
}
