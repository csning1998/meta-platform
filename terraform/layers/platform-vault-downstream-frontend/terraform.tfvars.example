target_components = { "vault" = { service = "vault-downstream", component = "frontend" } }
primary_role    = "vault"

service_config = {
  "vault" = {
    role            = "vault"
    network_tier    = "default"
    base_image_path = "../../../packer/output/base-baremetal-vault/ubuntu-24-base-baremetal-vault.qcow2"

    nodes = {
      # Single Mode
      "00" = { ip_suffix = 200, vcpu = 2, ram_size = 512 }
      # Uncomment the following lines for HA setup, abide by node % 2 != 0.
      # "01" = { ip_suffix = 201, vcpu = 2, ram_size = 512 },
      # "02" = { ip_suffix = 202, vcpu = 2, ram_size = 512 },
    }
  }
}

pki_identity = {
  intermediate_ca_common_name = "Platform Infrastructure Intermediate CA"
  intermediate_mount_path     = "pki-intermediate"
}

# The node count MUST equal the ip_range of the catalog, and the catalog MUST carry the self-managed-lb tag.
node_config = {
  "00" = { ip_suffix = 200, vcpu = 2, ram = 4096 }
  "01" = { ip_suffix = 201, vcpu = 2, ram = 4096 }
  "02" = { ip_suffix = 202, vcpu = 2, ram = 4096 }
}

talos_config = {
  talos_version      = "v1.13.8"
  kubernetes_version = "v1.36.5"
}

helm_chart_version = {
  cilium       = "1.20.2"
  cert_manager = "v1.21.2"
}
