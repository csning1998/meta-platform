
target_clusters = { "harbor_bootstrapper" = "platform-harbor-bootstrapper-frontend" }
primary_role    = "harbor_bootstrapper"

service_config = {
  "harbor_bootstrapper" = {
    role            = "harbor_bootstrapper"
    network_tier    = "default"
    base_image_path = "../../../packer/output/base-docker-harbor/ubuntu-24-base-docker-harbor.qcow2"
    nodes = {
      # "00" = { ip_suffix = 200, vcpu = 2, ram_size = 1536 } # for bare-minimum for test
      "00" = { ip_suffix = 200, vcpu = 4, ram_size = 8192 } # for production
    }
  }
}
