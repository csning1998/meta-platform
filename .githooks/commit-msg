#!/bin/sh
# Validates commit messages against Conventional Commits specification via meta-platform compose service.
# Activation: git config core.hooksPath .githooks

set -e

META_PLATFORM="/home/csning1998/GitLab/meta-platform"
REPO_ROOT="$(git rev-parse --show-toplevel)"
MSG_FILE="$(realpath "$1")"
export REPO_GIT_DIR="${REPO_ROOT}/.git"
export MSG_FILE

podman compose -f "${META_PLATFORM}/compose.yml" run --rm commitlint
