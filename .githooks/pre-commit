#!/bin/sh
# Blocks commits containing hardcoded secrets via meta-platform gitleaks compose service.
# Activation: git config core.hooksPath .githooks

set -e

META_PLATFORM="/home/csning1998/GitLab/meta-platform"
REPO_ROOT="$(git rev-parse --show-toplevel)"
export REPO_GIT_DIR="${REPO_ROOT}/.git"

podman compose -f "${META_PLATFORM}/compose.yml" run --rm gitleaks
